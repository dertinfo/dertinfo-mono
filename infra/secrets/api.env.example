# Copy to api.env (same folder) and fill in values.
# Important: use uncommented KEY=VALUE lines only.
#
# Injected into the process environment before the API starts
# (npm run start or Docker Compose env_file). .NET maps KEY__NESTED → KEY:NESTED.
#
# --- First-time onboarding ---
# 1) SQL (per machine): set server/login/password/database. Create an EMPTY database
#    with that name (SSMS or sqlcmd). Migrations run when the API starts.
#    Example Express: SqlConnection__ServerName=.\SQLEXPRESS
#
# 2) Auth0 (shared team dev tenant): ask a teammate or secrets vault for domain,
#    audience, SPA client IDs, and the Management API client id/secret.
#    Do not commit real secrets. Local SPA callbacks are fixed in appsettings.json
#    (http://localhost:44200 and http://localhost:44300) — they must be allowed
#    on the Auth0 applications for that tenant.
#
# 3) StorageAccount__Images__Key: leave the default Azurite emulator key for local.
#
# See infra/secrets/README.md and docs/configuration.md.

SqlConnection__ServerName=
SqlConnection__ServerAdminName=
SqlConnection__ServerAdminPassword=
SqlConnection__DatabaseName=
Auth0__Domain=
Auth0__Audience=
Auth0__ManagementClientId=
Auth0__ManagementClientSecret=
WebClient__Auth0__ClientId=
PwaClient__Auth0__ClientId=
StorageAccount__Images__Key=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
ApiInfo__ContactName=
ApiInfo__ContactEmail=
