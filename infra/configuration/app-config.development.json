{
  "githubEnvironment": "development",
  "appConfigurationName": "appcs-dev-dertinfo-config-uks",
  "appConfigurationLabel": "Development",
  "keyVaultName": "kv-dev-dertinfo-uks",
  "secrets": [
    {
      "name": "auth0-managementclientsecret",
      "prompt": "Auth0 Management Client secret"
    },
    {
      "name": "auth0-managementclientid",
      "prompt": "Auth0 Management Client ID"
    },
    {
      "name": "webclient-auth0-clientid",
      "prompt": "Web client Auth0 Client ID"
    },
    {
      "name": "pwaclient-auth0-clientid",
      "prompt": "PWA client Auth0 Client ID"
    },
    {
      "name": "appinsights-telemetryid",
      "prompt": "Application Insights instrumentation key (appi-dev-dertinfo-monitoring-uks)"
    },
    {
      "name": "az-storage-images-accountkey",
      "prompt": "Images storage account key (stdevdertinfoimagesuks)"
    },
    {
      "name": "az-storage-functions-accountkey",
      "prompt": "Function app storage account key"
    },
    {
      "name": "mailgun-apikey",
      "prompt": "Mailgun API key"
    },
    {
      "name": "sendgrid-apikey",
      "prompt": "SendGrid API key"
    },
    {
      "name": "sqlconnection-servername",
      "prompt": "SQL server FQDN (sql-dev-dertinfo-storage-uks.database.windows.net)"
    },
    {
      "name": "sqlconnection-databasename",
      "prompt": "SQL database name (sqldb-dev-dertinfo-storage-uks)"
    }
  ],
  "keyVaultReferences": [
    {
      "key": "Auth0:ManagementClientSecret",
      "secretName": "auth0-managementclientsecret"
    },
    {
      "key": "Auth0:ManagementClientId",
      "secretName": "auth0-managementclientid"
    },
    {
      "key": "WebClient:Auth0:ClientId",
      "secretName": "webclient-auth0-clientid"
    },
    {
      "key": "PwaClient:Auth0:ClientId",
      "secretName": "pwaclient-auth0-clientid"
    },
    {
      "key": "PwaClient:AppInsights:TelemetryId",
      "secretName": "appinsights-telemetryid"
    },
    {
      "key": "WebClient:AppInsights:TelemetryId",
      "secretName": "appinsights-telemetryid"
    },
    {
      "key": "StorageAccount:Images:Key",
      "secretName": "az-storage-images-accountkey"
    },
    {
      "key": "StorageAccount:Functions:Key",
      "secretName": "az-storage-functions-accountkey"
    },
    {
      "key": "Mailgun:ApiKey",
      "secretName": "mailgun-apikey"
    },
    {
      "key": "SendGrid:ApiKey",
      "secretName": "sendgrid-apikey"
    },
    {
      "key": "SqlConnection:ServerName",
      "secretName": "sqlconnection-servername"
    },
    {
      "key": "SqlConnection:DatabaseName",
      "secretName": "sqlconnection-databasename"
    }
  ],
  "keyValues": {
    "ApiInfo:ContactEmail": "dertinfo@gmail.com",
    "ApiInfo:ContactName": "David Hall",
    "ApiInfo:Description": "API for the DertInfo suite of products",
    "ApiInfo:TermsOfUse": "http://www.dertinfo.co.uk/terms",
    "ApiInfo:Title": "DertInfo API",
    "ApiInfo:Version": "v1",
    "Auth0:Audience": "api.test.dertinfo.co.uk",
    "Auth0:Domain": "dertinfotest.eu.auth0.com",
    "Constants:Defaults:EventImageName": "eventdefaultimage",
    "Constants:Defaults:GroupImageName": "groupdefaultimage",
    "Constants:ObfuscationIdLength": "6",
    "Cors:AllowedOrigins": "https://staging.dertinfo.co.uk, https://staging-app.dertinfo.co.uk",
    "DatabaseCache:Disabled": "false",
    "MailGun:Enabled": "false",
    "PwaClient:Api:Uri": "https://app-dev-dertinfo-api-uks.azurewebsites.net/api",
    "PwaClient:Auth0:Audience": "api.test.dertinfo.co.uk",
    "PwaClient:Auth0:CallbackUrl": "https://staging-app.dertinfo.co.uk",
    "PwaClient:Auth0:Domain": "dertinfotest.eu.auth0.com",
    "SendGrid:Enabled": "false",
    "StorageAccount:Images:BlobEndpoint": "https://stdevdertinfoimagesuks.blob.core.windows.net",
    "StorageAccount:Images:Name": "stdevdertinfoimagesuks",
    "StorageAccount:Images:Protocol": "https",
    "StorageAccount:Images:QueueEndpoint": "https://stdevdertinfoimagesuks.queue.core.windows.net",
    "StorageAccount:Images:TableEndpoint": "https://stdevdertinfoimagesuks.table.core.windows.net",
    "WebClient:Api:Uri": "https://app-dev-dertinfo-api-uks.azurewebsites.net/api",
    "WebClient:Auth0:Audience": "api.test.dertinfo.co.uk",
    "WebClient:Auth0:CallbackUrl": "https://staging.dertinfo.co.uk",
    "WebClient:Auth0:Domain": "dertinfotest.eu.auth0.com"
  }
}
